+    private final Runnable readCounter = new Runnable() {
+        @Override public void run() {
+            if (!active) return;
+            String url = browser.getUrl();
+            if (DuolingoLessonActivity.isDuolingoUrl(url)) {
+                final int generation = documentGeneration;
+                browser.evaluateJavascript("[window.__andorsDuoCorrectCount||0," +
+                        "!!window.__andorsDuoMonitor,!!window.__andorsDuoFeedbackVisible," +
+                        "window.__andorsDuoFeedbackMethod||'none'," +
+                        "!!(window.__andorsCombatUiV12&&window.__andorsCombatUiV12.inExercise)," +
+                        "window.__andorsCombatUiV12?window.__andorsCombatUiV12.actionLabel():''," +
+                        "window.__andorsCombatUiV12?window.__andorsCombatUiV12.answerPreview():''," +
+                        "window.__andorsCombatUiV12?window.__andorsCombatUiV12.questionText():''," +
+                        "window.__andorsCombatUiV12?window.__andorsCombatUiV12.audioCount():0," +
+                        "window.__andorsCombatUiV12?window.__andorsCombatUiV12.nativeState():null]", result -> {
+                    if (!active || generation != documentGeneration) return;
+                    try {
+                        JSONArray state = new JSONArray(result);
+                        long newCount = state.getLong(0);
+                        if (newCount < lastDocumentCount) {
+                            // Hard navigation creates a new JavaScript document.
+                            lastDocumentCount = newCount;
+                        }
+                        if (newCount > lastDocumentCount) {
+                            long delta = newCount - lastDocumentCount;
+                            lastDocumentCount = newCount;
+                            totalCorrectCount += delta;
+                            for (long i = 0; i < delta; i++) {
+                                if (correctListener != null) correctListener.onCorrectAnswer();
+                            }
+                        }
