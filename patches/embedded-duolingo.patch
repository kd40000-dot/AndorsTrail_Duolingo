+    private void rebuildNativeOptions(JSONArray options) {
+        nativeOptions.removeAllViews();
+        if (options == null) return;
+        // Three short choices fit comfortably in one row on phone screens.
+        // The previous two-column layout clipped the third option beneath
+        // the strict two-enemy-row combat height shown in the user's capture.
+        int columns = 2;
+        float screenWidthDp = getResources().getDisplayMetrics().widthPixels /
+                getResources().getDisplayMetrics().density;
+        if (screenWidthDp >= 310 && options.length() >= 3) {
+            boolean shortLabels = true;
+            for (int i = 0; i < options.length(); i++) {
+                JSONObject option = options.optJSONObject(i);
+                if (option == null || option.optString("text", "").length() > 16) {
+                    shortLabels = false;
+                    break;
+                }
+            }
+            if (shortLabels && (options.length() == 3 ||
+                    ("wordbank".equals(nativeMode) && options.length() >= 6))) {
+                columns = 3;
+            }
+        }
+        for (int i = 0; i < options.length(); i += columns) {
+            LinearLayout row = new LinearLayout(getContext());
+            row.setOrientation(HORIZONTAL);
+            for (int j = i; j < Math.min(i + columns, options.length()); j++) {
+                JSONObject option = options.optJSONObject(j);
+                if (option == null) continue;
+                int index = option.optInt("id", j);
+                Button button = createAudioButton(getContext(), option.optString("text", ""));
+                button.setTextSize(11);
+                button.setMaxLines(2);
+                button.setGravity(Gravity.CENTER);
+                button.setPadding(dp(3), 0, dp(3), 0);
+                button.setEnabled(!option.optBoolean("disabled"));
+                if (option.optBoolean("selected")) {
+                    GradientDrawable selectedFrame = new GradientDrawable(
+                            GradientDrawable.Orientation.TOP_BOTTOM,
+                            new int[]{Color.rgb(88, 120, 158), Color.rgb(46, 80, 112)});
+                    selectedFrame.setStroke(dp(2), Color.rgb(234, 205, 141));
+                    selectedFrame.setCornerRadius(dp(2));
+                    button.setBackground(selectedFrame);
+                }
+                button.setOnClickListener(v -> browser.evaluateJavascript(
+                        "window.__andorsCombatUiV12&&window.__andorsCombatUiV12.nativeTap(" +
+                                index + ")", null));
+                LinearLayout.LayoutParams params = new LinearLayout.LayoutParams(
+                        0, dp(columns == 3 ? 29 : 31), 1);
+                params.setMargins(dp(2), dp(1), dp(2), dp(1));
+                row.addView(button, params);
+            }
+            nativeOptions.addView(row, new LinearLayout.LayoutParams(-1, -2));
+        }
+    }
+
+    private void showNativeOrWeb() {
+        boolean nativeShown = !"web".equals(nativeMode) && !forceWeb;
+        nativeScroll.setVisibility(nativeShown ? View.VISIBLE : View.GONE);
+        // Alpha preserves the WebView's viewport, JS events and feedback
+        // layout; GONE or a zero-height WebView could break correct detection.
+        browser.setAlpha(nativeShown ? 0f : 1f);
+        webToggle.setVisibility("web".equals(nativeMode) ? View.GONE : View.VISIBLE);
+        webToggle.setText(forceWeb ? "Game" : "Web");
+    }
+
+    private Button createAudioButton(Context context, String label) {
+        Button button = new Button(context);
+        button.setText(label);
+        button.setTextSize(12);
+        button.setAllCaps(false);
+        button.setMinHeight(0);
+        button.setMinWidth(0);
+        button.setPadding(0, 0, 0, 0);
+        button.setTextColor(Color.rgb(237, 220, 184));
+        GradientDrawable frame = new GradientDrawable(
+                GradientDrawable.Orientation.TOP_BOTTOM,
+                new int[]{Color.rgb(52, 82, 116), Color.rgb(31, 51, 74)});
+        frame.setCornerRadius(dp(2));
+        frame.setStroke(dp(1), Color.rgb(120, 145, 176));
+        button.setBackground(frame);
+        return button;
+    }
+
+    private static String loadAsset(Context context, String path) {
+        StringBuilder result = new StringBuilder();
+        try (InputStream stream = context.getAssets().open(path);
+             BufferedReader reader = new BufferedReader(
+                     new InputStreamReader(stream, StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) result.append(line).append('\n');
+        } catch (IOException e) {
+            // An asset failure must never prevent combat or lesson login.
+            Log.w(TAG, "Could not load optional combat theme " + path, e);
+        }
+        return result.toString();
+    }
+
+    private void applyPanelHeight() {
+        android.view.ViewGroup.LayoutParams existing = getLayoutParams();
+        if (!(existing instanceof RelativeLayout.LayoutParams)) return;
+        int availableHeight = getResources().getDisplayMetrics().heightPixels;
+        final int desired;
+        if (inExercise) {
+            // Size this relative to the actual enemy info row, not the phone.
+            // Start at the two-row limit so the answer field and word-bank
+            // selection are not clipped; the small button can shrink it.
+            View enemyRow = getRootView().findViewById(R.id.combatview_monsterbar);
+            int enemyHeight = enemyRow == null ? 0 : enemyRow.getHeight();
+            if (enemyHeight <= 0) enemyHeight = dp(53);
+            desired = Math.round(enemyHeight * (enlarged ? 2.0f : 1.5f));
+        } else {
+            // Login and picking a lesson still need a normal-sized browser.
+            desired = Math.max(dp(260), Math.round(availableHeight *
+                    (enlarged ? 0.80f : 0.57f)));
+        }
+        if (existing.height != desired) {
+            existing.height = desired;
+            setLayoutParams(existing);
+        }
+        expand.setText(enlarged ? "−" : "+");
+    }
+
+    private int dp(int size) {
+        return Math.round(size * getResources().getDisplayMetrics().density);
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        hideLessons();
+        browser.stopLoading();
+        browser.destroy();
+        super.onDetachedFromWindow();
+    }
+}
