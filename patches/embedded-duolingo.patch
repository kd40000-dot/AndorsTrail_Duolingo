+package com.gpl.rpg.AndorsTrail.duolingo;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.graphics.Color;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.AttributeSet;
+import android.view.Gravity;
+import android.view.View;
+import android.webkit.CookieManager;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.RelativeLayout;
+import android.widget.TextView;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+
+/**
+ * Live Duolingo exercises inside the game's combat UI. The WebView stays
+ * attached to the battle view rather than launching a separate Activity.
+ * Duolingo itself remains responsible for verifying answers and recording
+ * XP, lessons and streaks; only success-count deltas enter combat logic.
+ */
+public final class DuolingoCombatPanel extends LinearLayout {
+    public interface CorrectAnswerListener {
+        void onCorrectAnswer();
+    }
+
+    private static final String START_URL = "https://www.duolingo.com/learn";
+    private static final String COMBAT_STYLES = "(function(){" +
+            "if(document.getElementById('andors-duo-combat-theme'))return;" +
+            "var s=document.createElement('style');s.id='andors-duo-combat-theme';" +
+            "s.textContent=':root{color-scheme:dark!important;}' +" +
+            "'html,body{margin:0!important;background:#172027!important;}' +" +
+            "'button{border-radius:7px!important;}' +" +
+            // Hide peripheral site chrome, never questions, answers, audio,
+            // matching tiles, progress controls or the feedback/Continue bar.
+            "'[data-test=sidebar],[data-test=topbar]{display:none!important;}';" +
+            "document.head.appendChild(s);" +
+            "})();";
+
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final TextView counter;
+    private final Button expand;
+    private final WebView browser;
+    private CorrectAnswerListener correctListener;
+    private boolean active;
+    private boolean started;
+    private boolean enlarged;
+    private long lastDocumentCount;
+    private long totalCorrectCount;
+    private int documentGeneration;
+    private String lastFeedback = "Waiting for lesson";
+
+    private final Runnable readCounter = new Runnable() {
+        @Override public void run() {
+            if (!active) return;
+            String url = browser.getUrl();
+            if (DuolingoLessonActivity.isDuolingoUrl(url)) {
+                final int generation = documentGeneration;
+                browser.evaluateJavascript("[window.__andorsDuoCorrectCount||0," +
+                        "!!window.__andorsDuoMonitor,!!window.__andorsDuoFeedbackVisible," +
+                        "window.__andorsDuoFeedbackMethod||'none']", result -> {
+                    if (!active || generation != documentGeneration) return;
+                    try {
+                        JSONArray state = new JSONArray(result);
+                        long newCount = state.getLong(0);
+                        if (newCount < lastDocumentCount) {
+                            // Hard navigation creates a new JavaScript document.
+                            lastDocumentCount = newCount;
+                        }
+                        if (newCount > lastDocumentCount) {
+                            long delta = newCount - lastDocumentCount;
+                            lastDocumentCount = newCount;
+                            totalCorrectCount += delta;
+                            for (long i = 0; i < delta; i++) {
+                                if (correctListener != null) correctListener.onCorrectAnswer();
+                            }
+                        }
+                        boolean monitor = state.getBoolean(1);
+                        boolean success = state.getBoolean(2);
+                        lastFeedback = !monitor ? "Connecting detector"
+                                : success ? "Correct · " + state.getString(3)
+                                : "Ready";
+                        updateCounter();
+                    } catch (JSONException ignored) {
+                        // Navigations can transiently interrupt JavaScript evaluation.
+                    }
+                });
+            }
+            handler.postDelayed(this, 200);
+        }
+    };
+
+    @SuppressLint("SetJavaScriptEnabled")
+    public DuolingoCombatPanel(Context context, AttributeSet attributes) {
+        super(context, attributes);
+        setOrientation(VERTICAL);
+        setBackgroundColor(Color.rgb(25, 33, 36));
+
+        LinearLayout header = new LinearLayout(context);
+        header.setOrientation(HORIZONTAL);
+        header.setGravity(Gravity.CENTER_VERTICAL);
+        header.setPadding(dp(8), dp(2), dp(8), dp(2));
+        header.setBackgroundColor(Color.rgb(41, 45, 41));
+
+        counter = new TextView(context);
+        counter.setTextColor(Color.rgb(229, 216, 189));
+        counter.setTextSize(13);
+        counter.setGravity(Gravity.CENTER_VERTICAL);
+        header.addView(counter, new LinearLayout.LayoutParams(0, dp(42), 1));
+
+        expand = new Button(context);
+        expand.setText("Expand");
+        expand.setTextSize(12);
+        expand.setMinHeight(0);
+        expand.setOnClickListener(v -> {
+            enlarged = !enlarged;
+            applyPanelHeight();
+        });
+        header.addView(expand);
+        addView(header);
+
+        browser = new WebView(context);
+        browser.setBackgroundColor(Color.rgb(23, 32, 39));
+        browser.getSettings().setJavaScriptEnabled(true);
+        browser.getSettings().setDomStorageEnabled(true);
+        browser.getSettings().setMediaPlaybackRequiresUserGesture(false);
+        CookieManager.getInstance().setAcceptCookie(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(browser, true);
+        browser.setWebChromeClient(new WebChromeClient());
+        browser.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                String host = request.getUrl().getHost();
+                return host == null || !(host.equals("duolingo.com")
+                        || host.endsWith(".duolingo.com"));
+            }
+
+            @Override public void onPageFinished(WebView view, String url) {
+                if (!DuolingoLessonActivity.isDuolingoUrl(url)) return;
+                documentGeneration++;
+                view.evaluateJavascript(DuolingoLessonActivity.STYLES, null);
+                view.evaluateJavascript(COMBAT_STYLES, null);
+                view.evaluateJavascript(DuolingoLessonActivity.CORRECT_FEEDBACK_MONITOR, null);
+            }
+        });
+        addView(browser, new LinearLayout.LayoutParams(-1, 0, 1));
+        updateCounter();
+    }
+
+    public void setCorrectAnswerListener(CorrectAnswerListener listener) {
+        correctListener = listener;
+    }
+
+    public void showLessons() {
+        if (active) return;
+        active = true;
+        setVisibility(View.VISIBLE);
+        applyPanelHeight();
+        browser.onResume();
+        if (!started) {
+            started = true;
+            browser.loadUrl(START_URL);
+        }
+        handler.removeCallbacks(readCounter);
+        handler.post(readCounter);
+    }
+
+    public void hideLessons() {
+        if (!active) return;
+        active = false;
+        handler.removeCallbacks(readCounter);
+        browser.onPause();
+        setVisibility(View.GONE);
+    }
+
+    public boolean isShowingLessons() {
+        return active;
+    }
+
+    private void updateCounter() {
+        counter.setText("Duolingo · " + totalCorrectCount + " correct · " + lastFeedback);
+    }
+
+    private void applyPanelHeight() {
+        android.view.ViewGroup.LayoutParams existing = getLayoutParams();
+        if (!(existing instanceof RelativeLayout.LayoutParams)) return;
+        int availableHeight = getResources().getDisplayMetrics().heightPixels;
+        int desired = Math.round(availableHeight * (enlarged ? 0.80f : 0.57f));
+        desired = Math.max(dp(260), desired);
+        if (existing.height != desired) {
+            existing.height = desired;
+            setLayoutParams(existing);
+        }
+        expand.setText(enlarged ? "Compact" : "Expand");
+    }
+
+    private int dp(int size) {
+        return Math.round(size * getResources().getDisplayMetrics().density);
+    }
+
+    @Override protected void onDetachedFromWindow() {
+        hideLessons();
+        browser.stopLoading();
+        browser.destroy();
+        super.onDetachedFromWindow();
+    }
+}
