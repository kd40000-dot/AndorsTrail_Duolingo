diff --git a/AndorsTrail/tools/test_duolingo_combat_skin.js b/AndorsTrail/tools/test_duolingo_combat_skin.js
new file mode 100644
index 00000000..7db7b44c
--- /dev/null
+++ b/AndorsTrail/tools/test_duolingo_combat_skin.js
@@ -0,0 +1,397 @@
+/* Minimal offline DOM fixtures for the injected combat-skin JavaScript.
+ * These checks exercise every role classifier without relying on a live
+ * account, Duolingo network responses or private web APIs. */
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const vm = require("node:vm");
+
+const source = fs.readFileSync(path.join(__dirname,
+  "../app/src/main/assets/duolingo/andors-combat.js"), "utf8");
+const css = fs.readFileSync(path.join(__dirname,
+  "../app/src/main/assets/duolingo/andors-combat.css"), "utf8");
+const monitor = fs.readFileSync(path.join(__dirname,
+  "../app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoLessonActivity.java"), "utf8");
+const panel = fs.readFileSync(path.join(__dirname,
+  "../app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoCombatPanel.java"), "utf8");
+
+function element(tag, attributes = {}, text = "", top = 30) {
+  return {
+    tag, tagName: tag.toUpperCase(), attributes: { ...attributes },
+    innerText: text, textContent: text,
+    parentElement: null, children: [], isConnected: true,
+    dispatchEvent(event) {
+      if (!this.events) this.events = [];
+      this.events.push(event.type);
+      return true;
+    },
+    getAttribute(name) { return this.attributes[name] ?? null; },
+    setAttribute(name, value) { this.attributes[name] = value; },
+    removeAttribute(name) { delete this.attributes[name]; },
+    contains(other) {
+      return this === other || this.children.some(child => child.contains(other));
+    },
+    querySelector(selector) {
+      if (selector === "button,input,textarea,[role=button]") {
+        const descendants = (node) => node.children.some(child =>
+          ["button", "input", "textarea"].includes(child.tag) ||
+          child.getAttribute("role") === "button" || descendants(child));
+        return descendants(this) ? {} : null;
+      }
+      return null;
+    },
+    getBoundingClientRect() { return { width: 150, height: 40,
+      top, bottom: top + 40 }; },
+    getClientRects() { return [this.getBoundingClientRect()]; },
+    closest(selector) {
+      if (selector === '[data-andors-ui="feedback"]') {
+        let parent = this.parentElement;
+        while (parent) {
+          if (parent.getAttribute("data-andors-ui") === "feedback") return parent;
+          parent = parent.parentElement;
+        }
+      }
+      return null;
+    },
+    matches(selector) {
+      if (selector.includes("button") && this.tag === "button") return true;
+      if (selector.includes("[role=button]") &&
+          this.getAttribute("role") === "button") return true;
+      if (selector.includes("[role=radio]") &&
+          this.getAttribute("role") === "radio") return true;
+      return selector.includes("[role=checkbox]") &&
+        this.getAttribute("role") === "checkbox";
+    }
+  };
+}
+
+function runFixture(url, nodes) {
+  const classes = new Set();
+  const root = element("html");
+  root.classList = {
+    add(name) { classes.add(name); },
+    toggle(name, active) {
+      if (active) classes.add(name);
+      else classes.delete(name);
+    }
+  };
+
+  const queryAll = (selector) => {
+    if (selector === "[data-test]") return nodes.filter(n => n.getAttribute("data-test"));
+    if (selector === '[data-test="challenge"]') return nodes.filter(n =>
+      n.getAttribute("data-test") === "challenge");
+    if (selector === '[data-andors-ui="audio"]') return nodes.filter(n =>
+      n.getAttribute("data-andors-ui") === "audio");
+    if (/^\[data-andors-ui="(?:choice|word|match)"\]$/.test(selector)) {
+      const role = selector.match(/="(.*?)"/)[1];
+      return nodes.filter(n => n.getAttribute("data-andors-ui") === role);
+    }
+    if (selector.includes('[data-test="challenge-translate-prompt"]') &&
+        selector.includes('blockquote')) return nodes.filter(n =>
+      ["challenge-translate-prompt", "challenge-prompt", "challenge-sentence",
+        "challenge-phrase", "challenge-text", "challenge-word"]
+        .includes(n.getAttribute("data-test")) ||
+      ["h1", "h2", "h3", "blockquote"].includes(n.tag));
+    if (selector.startsWith('h1,h2,h3,p,span,')) return nodes.filter(n =>
+      ["h1", "h2", "h3", "p", "span"].includes(n.tag) ||
+      n.getAttribute("lang") !== null || n.getAttribute("dir") === "auto");
+    if (selector === "h1,h2,h3") return nodes.filter(n => /^h[123]$/.test(n.tag));
+    if (selector === "img,svg,canvas") return nodes.filter(n =>
+      ["img", "svg", "canvas"].includes(n.tag));
+    if (selector === "button,[role=button]") return nodes.filter(n =>
+      n.tag === "button" || n.getAttribute("role") === "button");
+    if (selector.includes('[data-andors-ui="word"][aria-pressed="true"]')) {
+      return nodes.filter(n => n.getAttribute("data-andors-ui") === "word" &&
+        n.getAttribute("aria-pressed") === "true");
+    }
+    if (selector.startsWith("textarea,input:")) return nodes.filter(n =>
+      n.tag === "textarea" || n.tag === "input" ||
+      n.getAttribute("contenteditable") === "true");
+    if (selector.includes('[data-test="challenge"]')) return nodes.filter(n =>
+      ["challenge", "challenge-header", "challenge-tap-token", "challenge-choice"]
+        .includes(n.getAttribute("data-test")));
+    return [];
+  };
+
+  let observerCount = 0;
+  const context = {
+    document: {
+      body: element("body"), documentElement: root,
+      querySelectorAll: queryAll,
+      querySelector(selector) { return queryAll(selector)[0] ?? null; },
+      createTextNode(text) { return { textContent: text }; }
+    },
+    location: { pathname: url },
+    MutationObserver: class {
+      constructor() { observerCount++; }
+      observe() { }
+    },
+    window: {
+      innerHeight: 900,
+      requestAnimationFrame(callback) { callback(); },
+      setInterval() { },
+      addEventListener() { }
+    },
+    Map,
+    Event: class { constructor(type) { this.type = type; } },
+    HTMLInputElement: class {
+      set value(next) {
+        Object.defineProperty(this, "value", { value: next, writable: true,
+          configurable: true });
+      }
+    },
+    HTMLTextAreaElement: class {
+      set value(next) {
+        Object.defineProperty(this, "value", { value: next, writable: true,
+          configurable: true });
+      }
+    }
+  };
+  vm.runInNewContext(source, context);
+  vm.runInNewContext(source, context); // Must be idempotent on SPA reinjection.
+  assert.equal(observerCount, 1);
+  return { root, classes, nodes, api: context.window.__andorsCombatUiV12 };
+}
+
+const home = runFixture("/learn", [
+  element("button", { "data-test": "skill-node" }, "Start")
+]);
+assert(home.classes.has("andors-duo-combat"));
+assert(!home.classes.has("andors-duo-exercise"));
+
+const matchingTiles = Array.from({ length: 4 }, (_, i) =>
+  element("button", { "data-test": "challenge-matching-pair" }, "Tile " + i));
+const feedback = element("div", { "data-test": "challenge-footer" });
+const successHeading = element("h2", {}, "Correct", 760);
+successHeading.parentElement = feedback;
+const match = runFixture("/lesson/1", [
+  element("div", { "data-test": "challenge-header" }),
+  element("h2", {}, "Match the pairs", 90),
+  ...matchingTiles, feedback, successHeading
+]);
+assert(match.classes.has("andors-duo-exercise"));
+assert.equal(match.root.getAttribute("data-andors-exercise"), "matching");
+assert(matchingTiles.every(tile => tile.getAttribute("data-andors-ui") === "match"));
+assert.equal(feedback.getAttribute("data-andors-ui"), "feedback");
+assert.equal(successHeading.getAttribute("data-andors-ui"), null,
+  "The feedback heading must keep its original green success color");
+
+const matchGrid = element("div");
+matchGrid.children = matchingTiles;
+matchingTiles.forEach(t => { t.parentElement = matchGrid; });
+runFixture("/lesson/matching-grid", [
+  element("div", { "data-test": "challenge-header" }), ...matchingTiles
+]);
+assert.equal(matchGrid.getAttribute("data-andors-layout"), "matches");
+
+const wordTokens = Array.from({ length: 4 }, (_, i) =>
+  element("button", { "data-test": "challenge-tap-token" }, "Word " + i));
+const tokenParent = element("div");
+tokenParent.children = wordTokens;
+wordTokens.forEach(t => { t.parentElement = tokenParent; });
+const wordbank = runFixture("/lesson/2", [
+  element("div", { "data-test": "challenge-header" }), ...wordTokens
+]);
+assert.equal(wordbank.root.getAttribute("data-andors-exercise"), "wordbank");
+assert.equal(tokenParent.getAttribute("data-andors-layout"), "wordbank");
+assert(wordTokens.every(token => token.getAttribute("data-andors-ui") === "word"));
+wordTokens[0].setAttribute("aria-pressed", "true");
+assert.equal(wordbank.api.answerPreview(), "Word 0");
+
+const input = element("textarea", { "data-test": "challenge-text-input" });
+const check = element("button", { "data-test": "challenge-check-button" }, "Check");
+const instruction = element("h2", {}, "Type what you hear", 65);
+const pictureParent = element("div");
+const picture = element("svg", {}, "", 90);
+picture.getBoundingClientRect = () => ({ width: 150, height: 180, top: 90, bottom: 270 });
+pictureParent.children = [picture];
+picture.parentElement = pictureParent;
+const typing = runFixture("/lesson/3", [
+  element("div", { "data-test": "challenge-header" }), instruction,
+  picture, input, check
+]);
+assert.equal(typing.root.getAttribute("data-andors-exercise"), "typing");
+assert.equal(check.getAttribute("data-andors-ui"), "submit");
+assert.equal(instruction.getAttribute("data-andors-ui"), "instruction");
+assert.equal(pictureParent.getAttribute("data-andors-ui"), "illustration");
+
+const choiceButtons = [
+  element("button", { "data-test": "challenge-choice" }, "Option A"),
+  element("button", { "data-test": "challenge-choice" }, "Option B")
+];
+const choices = runFixture("/lesson/4", [
+  element("div", { "data-test": "challenge-header" }), ...choiceButtons
+]);
+assert.equal(choices.root.getAttribute("data-andors-exercise"), "choices");
+assert(choiceButtons.every(button => button.getAttribute("data-andors-ui") === "choice"));
+assert.equal(choiceButtons[0].getAttribute("data-andors-ui"), "choice",
+  "Image-based answers must never be classified as illustrations");
+
+const audioButton = element("button", {
+  "data-test": "challenge-audio-button", "aria-label": "Play audio"
+});
+const listening = runFixture("/lesson/5", [
+  element("div", { "data-test": "challenge-header" }), audioButton
+]);
+assert.equal(audioButton.getAttribute("data-andors-ui"), "audio");
+let playbackCount = 0;
+audioButton.click = () => playbackCount++;
+// A refresh identifies the prompt speaker, but playback is user-controlled.
+listening.api.refresh();
+assert.equal(listening.api.audioCount(), 1);
+assert.equal(playbackCount, 0);
+assert.equal(audioButton.getAttribute("data-andors-mirror"), "audio");
+assert.equal(listening.api.playAudio(0), true);
+assert.equal(playbackCount, 1);
+
+const prompt = element("div", { "data-test": "challenge-translate-prompt" },
+  "La rata duerme.");
+const promptFixture = runFixture("/lesson/translate", [
+  element("div", { "data-test": "challenge-header" }), prompt,
