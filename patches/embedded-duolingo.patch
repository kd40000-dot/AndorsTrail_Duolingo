+    private void updateNativeUi(JSONObject state) {
+        String nextMode = state == null ? "web" : state.optString("mode", "web");
+        if (!inExercise) nextMode = "web";
+        String prompt = state == null ? "" : state.optString("prompt", "");
+        String nextKey = nextMode + "|" + prompt;
+        boolean changedExercise = !nextKey.equals(nativeExerciseKey);
+        if (changedExercise) {
+            nativeExerciseKey = nextKey;
+            nativeOptionsSignature = "";
+            forceWeb = false;
+            nativeInput.clearFocus();
+        }
+        nativeMode = nextMode;
+        nativePrompt.setText(prompt);
+        nativePrompt.setVisibility(prompt.isEmpty() ? View.GONE : View.VISIBLE);
+
+        boolean typing = "typing".equals(nextMode);
+        nativeInput.setVisibility(typing ? View.VISIBLE : View.GONE);
+        nativeOptions.setVisibility(typing ? View.GONE : View.VISIBLE);
+        if (typing) {
+            String answer = state.optString("input", "");
+            if ((changedExercise || !nativeInput.hasFocus()) &&
+                    !nativeInput.getText().toString().equals(answer)) {
+                updatingInput = true;
+                nativeInput.setText(answer);
+                nativeInput.setSelection(nativeInput.length());
+                updatingInput = false;
+            }
+            nativeSelected.setVisibility(View.GONE);
+        } else {
+            JSONArray options = state == null ? null : state.optJSONArray("options");
+            String signature = options == null ? "" : options.toString();
+            if (!signature.equals(nativeOptionsSignature)) {
+                nativeOptionsSignature = signature;
+                rebuildNativeOptions(options);
+            }
+            String selected = state == null ? "" : state.optString("selected", "");
+            boolean showSelected = "wordbank".equals(nextMode) && !selected.isEmpty();
+            nativeSelected.setText(showSelected ? "ANSWER: " + selected : "");
+            nativeSelected.setVisibility(showSelected ? View.VISIBLE : View.GONE);
+        }
+        showNativeOrWeb();
+    }
