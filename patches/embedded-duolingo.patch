+++ b/AndorsTrail/app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoLessonActivity.java
@@ -0,0 +1,110 @@
+package com.gpl.rpg.AndorsTrail.duolingo;
+
+import android.annotation.SuppressLint;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.view.Gravity;
+import android.view.View;
+import android.webkit.CookieManager;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import com.gpl.rpg.AndorsTrail.activity.AndorsTrailBaseActivity;
+
+/**
+ * First embedded Duolingo lesson prototype. All exercises remain hosted and
+ * scored by Duolingo; the app does not forge XP or mark lessons complete.
+ *
+ * UI selectors and per-answer events have intentionally not been wired to
+ * combat until a real session proves WebView login and lesson compatibility.
+ */
+public final class DuolingoLessonActivity extends AndorsTrailBaseActivity {
+    private static final String START_URL = "https://www.duolingo.com/learn";
+    private WebView lesson;
+    private TextView status;
+
+    @SuppressLint("SetJavaScriptEnabled")
+    @Override public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        LinearLayout frame = new LinearLayout(this);
+        frame.setOrientation(LinearLayout.VERTICAL);
+        frame.setBackgroundColor(Color.rgb(16, 23, 28));
+
+        LinearLayout toolbar = new LinearLayout(this);
+        toolbar.setPadding(dp(12), dp(6), dp(12), dp(6));
+        toolbar.setGravity(Gravity.CENTER_VERTICAL);
+        toolbar.setBackgroundColor(Color.rgb(35, 44, 48));
+
+        status = new TextView(this);
+        status.setText("Duolingo · Vietnamese");
+        status.setTextColor(Color.WHITE);
+        status.setTextSize(16);
+        toolbar.addView(status, new LinearLayout.LayoutParams(0, dp(45), 1));
+        status.setGravity(Gravity.CENTER_VERTICAL);
+
+        Button close = new Button(this);
+        close.setText("Return to battle");
+        close.setOnClickListener(v -> finish());
+        toolbar.addView(close);
+        frame.addView(toolbar);
+
+        lesson = new WebView(this);
+        lesson.setBackgroundColor(Color.rgb(16, 23, 28));
+        lesson.getSettings().setJavaScriptEnabled(true);
+        lesson.getSettings().setDomStorageEnabled(true);
+        lesson.getSettings().setMediaPlaybackRequiresUserGesture(false);
+        CookieManager.getInstance().setAcceptCookie(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(lesson, true);
+        lesson.setWebChromeClient(new WebChromeClient());
+        lesson.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                // Keep authentication and exercises inside Duolingo's own site.
+                String host = request.getUrl().getHost();
+                return host == null || !(host.equals("duolingo.com") || host.endsWith(".duolingo.com"));
+            }
+
+            @Override public void onPageFinished(WebView view, String url) {
+                if (url.startsWith("https://www.duolingo.com/") ||
+                        url.startsWith("https://duolingo.com/")) {
+                    view.evaluateJavascript(STYLES, null);
+                    status.setText("Duolingo · Live lesson");
+                }
+            }
+        });
+        frame.addView(lesson, new LinearLayout.LayoutParams(-1, 0, 1));
+        setContentView(frame);
+        lesson.loadUrl(START_URL);
+    }
+
+    // Conservative first styling pass: frame the live site with the game's
+    // dark palette without suppressing sign-in, answer or Continue controls.
+    private static final String STYLES = "(function(){" +
+            "if(document.getElementById('andors-duo-theme'))return;" +
+            "var s=document.createElement('style');s.id='andors-duo-theme';" +
+            "s.textContent='html,body{margin:0!important;}" +
+            "button{border-radius:8px!important;}';" +
+            "document.head.appendChild(s);" +
+            "})();";
+
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    @Override public void onBackPressed() {
+        if (lesson != null && lesson.canGoBack()) lesson.goBack();
+        else super.onBackPressed();
+    }
+
+    @Override protected void onDestroy() {
+        if (lesson != null) {
+            lesson.stopLoading();
+            lesson.destroy();
+            lesson = null;
+        }
+        super.onDestroy();
+    }
+}
