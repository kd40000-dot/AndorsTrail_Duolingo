+                        boolean success = state.getBoolean(2);
+                        boolean nowInExercise = state.getBoolean(4);
+                        if (inExercise != nowInExercise) {
+                            inExercise = nowInExercise;
+                            applyPanelHeight();
+                        }
+                        String actionLabel = state.optString(5, "");
+                        submit.setVisibility(inExercise ? View.VISIBLE : View.GONE);
+                        submit.setEnabled(!actionLabel.isEmpty());
+                        submit.setText(actionLabel.isEmpty() ? "Check" : actionLabel);
+                        String preview = state.optString(6, "");
+                        String newQuestion = state.optString(7, "");
+                        int audioCount = state.optInt(8, 0);
+                        updateNativeUi(state.optJSONObject(9));
+                        boolean nativeShown = !"web".equals(nativeMode) && !forceWeb;
+                        question.setText(nativeShown ? "" : newQuestion);
+                        question.setVisibility(nativeShown || newQuestion.isEmpty() ?
+                                View.GONE : View.VISIBLE);
+                        playAudio.setVisibility(audioCount > 0 ? View.VISIBLE : View.GONE);
+                        playSlowAudio.setVisibility(audioCount > 1 ? View.VISIBLE : View.GONE);
+                        questionBar.setVisibility(inExercise &&
+                                ((!nativeShown && !newQuestion.isEmpty()) || audioCount > 0) ?
+                                View.VISIBLE : View.GONE);
+                        lastFeedback = !monitor ? "Connecting"
+                                : success ? "Correct — attack queued"
+                                : preview.isEmpty() ? "Ready for answer" : "Answer: " + preview;
+                        updateCounter();
+                    } catch (JSONException ignored) {
+                        // Navigations can transiently interrupt JavaScript evaluation.
+                    }
+                });
+            }
+            handler.postDelayed(this, 200);
+        }
+    };
