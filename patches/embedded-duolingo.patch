diff --git a/AndorsTrail/app/src/main/assets/duolingo/andors-combat.css b/AndorsTrail/app/src/main/assets/duolingo/andors-combat.css
new file mode 100644
index 00000000..41a372c3
--- /dev/null
+++ b/AndorsTrail/app/src/main/assets/duolingo/andors-combat.css
@@ -0,0 +1,366 @@
+/*
+ * Andor's Trail language-combat skin.
+ *
+ * Scope the strong rules to an active exercise. The learn map and login flow
+ * stay usable, and Duolingo continues to own every actual answer control.
+ * In particular, never hide the feedback/Continue strip: the existing combat
+ * answer detector depends on its visible success state.
+ */
+:root.andors-duo-combat {
+  color-scheme: dark;
+  --at-night: #101c2c;
+  --at-blue: #253d59;
+  --at-blue-light: #345579;
+  --at-frame: #7287a3;
+  --at-edge: #0a111b;
+  --at-paper: #f0e3c7;
+  --at-gold: #edc783;
+}
+
+html.andors-duo-combat,
+html.andors-duo-combat body {
+  margin: 0 !important;
+  background: #101c2c !important;
+  color: var(--at-paper);
+}
+
+html.andors-duo-combat body {
+  background-image:
+    linear-gradient(135deg, rgba(91, 114, 143, .09) 25%, transparent 25%),
+    linear-gradient(225deg, rgba(91, 114, 143, .09) 25%, transparent 25%) !important;
+  background-size: 24px 24px !important;
+}
+
+/* Site chrome is useful on the learn screen only insofar as it navigates
+ * lessons. Side rails and the global top bar waste battle-screen space. */
+html.andors-duo-combat [data-test="sidebar"],
+html.andors-duo-combat [data-test="topbar"] {
+  display: none !important;
+}
+
+html.andors-duo-exercise,
+html.andors-duo-exercise body {
+  font-family: "Courier New", "Liberation Mono", monospace !important;
+}
+
+html.andors-duo-exercise [data-test="challenge"],
+html.andors-duo-exercise [data-test="challenge-container"] {
+  background: linear-gradient(180deg, #192a40 0%, #101c2c 100%) !important;
+  outline: 2px solid #516d8e;
+  outline-offset: -2px;
+}
+
+html.andors-duo-exercise [data-test="challenge-header"],
+html.andors-duo-exercise [data-test="challenge-prompt"] {
+  background-color: #1e3048 !important;
+  border-left: 3px solid var(--at-gold) !important;
+  padding: 8px 10px !important;
+}
+
+/* Keep the live question inside an RPG dialogue-style panel. These
+ * attributes are added to the original elements, never to cloned answers. */
+html.andors-duo-exercise [data-andors-ui="prompt"] {
+  color: var(--at-paper) !important;
+  font-family: "Courier New", "Liberation Mono", monospace !important;
+  font-size: clamp(17px, 4.2vw, 23px) !important;
+  font-weight: 700 !important;
+  line-height: 1.45 !important;
+  letter-spacing: .01em !important;
+  text-shadow: 1px 2px 0 rgba(0, 0, 0, .65) !important;
+}
+
+html.andors-duo-exercise button:not([data-andors-ui="audio"]),
+html.andors-duo-exercise [role="button"]:not([data-andors-ui="audio"]) {
+  font-family: "Courier New", "Liberation Mono", monospace !important;
+  border-radius: 3px !important;
+  border: 2px solid var(--at-frame) !important;
+  background-color: var(--at-blue) !important;
+  background-image: linear-gradient(#34506e, #20344c) !important;
+  color: var(--at-paper) !important;
+  box-shadow:
+    inset 1px 1px 0 rgba(227, 239, 255, .25),
+    inset -2px -2px 0 rgba(6, 13, 24, .65),
+    1px 2px 0 var(--at-edge) !important;
+  text-transform: none !important;
+  transition: background-color .08s linear, filter .08s linear !important;
+  touch-action: manipulation;
+}
+
+html.andors-duo-exercise button:not([data-andors-ui="audio"]):active,
+html.andors-duo-exercise [role="button"]:not([data-andors-ui="audio"]):active {
+  filter: brightness(1.24) !important;
+  box-shadow: inset 2px 2px 0 rgba(0, 0, 0, .38) !important;
+}
+
+html.andors-duo-exercise button:disabled,
+html.andors-duo-exercise [role="button"][aria-disabled="true"] {
+  opacity: .55 !important;
+}
+
+/* Submitting and continuing use the game's gold-highlighted action style.
+ * Never suppress the original Continue button or change its click handler. */
+html.andors-duo-exercise [data-andors-ui="submit"] {
+  background: linear-gradient(#806440, #594329) !important;
+  border-color: var(--at-gold) !important;
+  color: #fff4d6 !important;
+  font-weight: 700 !important;
+  min-height: 42px;
+}
+
+/* Word-bank tokens and matching tiles retain Duolingo's actual elements. */
+html.andors-duo-exercise [data-andors-ui="word"],
+html.andors-duo-exercise [data-andors-ui="match"],
+html.andors-duo-exercise [data-andors-ui="choice"] {
+  min-height: 40px !important;
+  padding: 7px 11px !important;
+  line-height: 1.35 !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="match"] {
+  min-height: 53px !important;
+  border-color: #97adbd !important;
+  white-space: normal !important;
+}
+
+html.andors-duo-exercise [data-andors-layout="wordbank"] {
+  display: flex !important;
+  flex-wrap: wrap !important;
+  align-items: center !important;
+  justify-content: center !important;
+  gap: 7px !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="word"][aria-pressed="true"],
+html.andors-duo-exercise [data-andors-ui="choice"][aria-checked="true"],
+html.andors-duo-exercise [data-andors-ui="choice"][aria-selected="true"] {
+  background: linear-gradient(#557ca2, #2c506f) !important;
+  border-color: #d8caa6 !important;
+}
+
+/* Text responses should resemble the dialogue input field. Do not mask
+ * the entered text or interfere with IME composition and Vietnamese accents. */
+html.andors-duo-exercise input:not([type="hidden"]),
+html.andors-duo-exercise textarea,
+html.andors-duo-exercise [contenteditable="true"] {
+  background-color: #0e1927 !important;
+  color: #fff1d5 !important;
+  border: 2px solid #879bb2 !important;
+  border-radius: 3px !important;
+  font-family: "Courier New", "Liberation Mono", monospace !important;
+  font-size: max(16px, 1em) !important;
+  caret-color: #f4ce7d !important;
+  outline-offset: 2px !important;
+}
+
+html.andors-duo-exercise input::placeholder,
+html.andors-duo-exercise textarea::placeholder {
+  color: #aebdd1 !important;
+}
+
+html.andors-duo-exercise input:focus,
+html.andors-duo-exercise textarea:focus,
+html.andors-duo-exercise [contenteditable="true"]:focus {
+  border-color: var(--at-gold) !important;
+  outline: 1px solid #cba772 !important;
+}
+
+/* Speaker, playback and microphone controls keep their hit areas and icons. */
+html.andors-duo-exercise [data-andors-ui="audio"] {
+  border-radius: 3px !important;
+  outline: 2px solid #6384a8;
+  outline-offset: 1px;
+}
+
+/* Let genuine Duolingo feedback use its own green/red colors. We only frame
+ * its buttons; the green success text is part of the proven answer detector. */
+html.andors-duo-exercise [data-andors-ui="feedback"] {
+  border-top: 3px solid #7287a3 !important;
+}
+
+html.andors-duo-exercise [role="progressbar"],
+html.andors-duo-exercise [data-andors-ui="progress"] {
+  border-radius: 2px !important;
+}
+
+/* v8 mini encounter: keep the battle map visible. Login and the lesson
+ * picker are deliberately excluded; they still use the larger WebView. */
+html.andors-duo-exercise,
+html.andors-duo-exercise body,
+html.andors-duo-exercise #root,
+html.andors-duo-exercise [role="main"],
+html.andors-duo-exercise main {
+  min-height: 0 !important;
+  height: auto !important;
+  max-height: none !important;
+  margin: 0 !important;
+  padding: 0 !important;
+}
+
+html.andors-duo-exercise body {
+  font-size: 12px !important;
+  line-height: 1.15 !important;
+  overflow-y: auto !important;
+  overscroll-behavior: contain;
+  padding-bottom: 34px !important;
+}
+
+html.andors-duo-exercise header,
+html.andors-duo-exercise [role="progressbar"],
+html.andors-duo-exercise [data-andors-ui="progress"],
+html.andors-duo-exercise [data-andors-chrome="hide"],
+html.andors-duo-exercise [data-andors-ui="instruction"],
+html.andors-duo-exercise [data-andors-ui="illustration"] {
+  display: none !important;
+}
+
+/* The native question strip mirrors only identified prompts and playback
+ * controls. Everything else stays in the authenticated Duolingo DOM. */
+html.andors-duo-exercise [data-andors-mirror="question"],
+html.andors-duo-exercise [data-andors-mirror="audio"] {
+  display: none !important;
+}
+
+html.andors-duo-exercise [data-test="challenge"],
+html.andors-duo-exercise [data-test="challenge-container"],
+html.andors-duo-exercise [data-test="challenge-content"],
+html.andors-duo-exercise [data-test="challenge-body"] {
+  min-height: 0 !important;
+  height: auto !important;
+  width: 100% !important;
+  max-width: none !important;
+  margin: 0 !important;
+  padding: 2px 4px !important;
+  gap: 3px !important;
+  justify-content: flex-start !important;
+  align-items: stretch !important;
+}
+
+html.andors-duo-exercise [data-test="challenge-header"],
+html.andors-duo-exercise [data-test="challenge-prompt"] {
+  min-height: 0 !important;
+  margin: 0 !important;
+  padding: 1px 4px !important;
+}
+
+/* The original answer buttons can be 60–120 px high. Shrink only their
+ * layout; do not replace their nodes or event handlers. */
+html.andors-duo-exercise button:not([data-andors-ui="audio"]),
+html.andors-duo-exercise [role="button"]:not([data-andors-ui="audio"]) {
+  min-height: 27px !important;
+  height: auto !important;
+  padding: 2px 6px !important;
+  margin: 0 !important;
+  font-size: 12px !important;
+  line-height: 1.15 !important;
+  box-shadow: inset 1px 1px 0 rgba(227, 239, 255, .2) !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="match"] {
+  min-height: 30px !important;
+  padding: 3px 5px !important;
+  font-size: 12px !important;
+  line-height: 1.1 !important;
+}
+
+html.andors-duo-exercise [data-andors-layout="matches"] {
+  display: grid !important;
+  grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
+  grid-auto-rows: min-content !important;
+  gap: 3px 5px !important;
+  min-height: 0 !important;
+  height: auto !important;
+  padding: 1px 3px !important;
+  margin: 0 !important;
+}
+
+html.andors-duo-exercise [data-andors-layout="matches"] > *,
+html.andors-duo-exercise [data-andors-layout="matches"] > * > * {
+  min-height: 0 !important;
+  height: auto !important;
+  margin: 0 !important;
+  gap: 3px !important;
+}
+
+html.andors-duo-exercise [data-andors-layout="wordbank"] {
+  gap: 3px !important;
+  padding: 0 !important;
+  margin: 1px 0 !important;
+}
+
+/* The selected words/response line needs to remain readable even while the
+ * player scrolls the bank underneath it in the tiny combat viewport. */
+html.andors-duo-exercise [data-andors-layout="selected-answer"] {
+  position: sticky !important;
+  top: 0 !important;
+  z-index: 50 !important;
+  background: #16263a !important;
+  border-bottom: 1px solid #8197b5 !important;
+  min-height: 25px !important;
+  max-height: 64px !important;
+  overflow-y: auto !important;
+  margin: 0 !important;
+  padding: 2px 4px !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="word"],
+html.andors-duo-exercise [data-andors-ui="choice"] {
+  min-height: 27px !important;
+  padding: 2px 5px !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="audio"] {
+  min-height: 26px !important;
+  min-width: 33px !important;
+  max-height: 34px !important;
+  padding: 1px !important;
+  margin: 0 !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="audio"] svg {
+  max-height: 24px !important;
+  max-width: 35px !important;
+}
+
+html.andors-duo-exercise input:not([type="hidden"]),
+html.andors-duo-exercise textarea,
+html.andors-duo-exercise [contenteditable="true"] {
+  min-height: 30px !important;
+  height: 30px !important;
+  padding: 3px 6px !important;
+  margin: 2px 0 !important;
+  font-size: 14px !important;
+  line-height: 1.25 !important;
+}
+
+html.andors-duo-exercise [data-test="challenge-footer"],
+html.andors-duo-exercise [data-andors-ui="feedback"] {
+  position: static !important;
+  min-height: 0 !important;
+  height: auto !important;
+  padding: 2px 4px !important;
+  margin: 1px 0 !important;
+  gap: 3px !important;
+}
+
+html.andors-duo-exercise [data-andors-ui="submit"] {
+  min-height: 28px !important;
+  padding: 3px 8px !important;
+}
+
+@media (max-width: 560px) {
+  html.andors-duo-exercise [data-andors-ui="word"],
+  html.andors-duo-exercise [data-andors-ui="choice"] {
+    min-height: 27px !important;
+    padding: 2px 5px !important;
+  }
+  html.andors-duo-exercise [data-andors-ui="match"] {
+    min-height: 30px !important;
+    padding: 2px 5px !important;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html.andors-duo-exercise button {
+    transition: none !important;
+  }
+}
diff --git a/AndorsTrail/app/src/main/assets/duolingo/andors-combat.js b/AndorsTrail/app/src/main/assets/duolingo/andors-combat.js
new file mode 100644
index 00000000..6b5553a2
--- /dev/null
+++ b/AndorsTrail/app/src/main/assets/duolingo/andors-combat.js
@@ -0,0 +1,607 @@
+(function () {
+  "use strict";
+
+  /*
+   * Annotate Duolingo's live controls without cloning/reparenting the answers.
+   * The native Check button may click the original Duolingo action, but only
+   * on a direct player tap. Duolingo still grades every exercise.
+   */
+  if (window.__andorsCombatUiV12) {
+    window.__andorsCombatUiV12.refresh();
+    return;
+  }
+
+  var root = document.documentElement;
+  var scheduled = false;
+  var lastType = "none";
+  var observers = [];
+  var mirroredQuestion = null;
+  var questionValue = "";
+  var mirroredAudio = [];
+  var nativeTargets = [];
+  var nativeInput = null;
+  var roles = {
+    word: /(?:tap-token|word-bank|wordbank|token-button|token-item)/,
+    match: /(?:match|pair)/,
+    choice: /(?:choice|option|multiple-choice|select-answer|answer-choice)/,
+    audio: /(?:audio|speaker|listen|microphone|record|sound|play-button)/,
+    submit: /(?:challenge-check|challenge-continue|submit-button|check-button|continue-button)/,
+    feedback: /(?:challenge-footer|feedback|result-panel|answer-feedback)/,
+    progress: /(?:lesson-progress|challenge-progress|progress-bar)/
+  };
+  var instruction = /^(?:type what you hear|type the missing word|tap the matching pairs|match the pairs|translate this sentence|write this in (?:english|vietnamese|spanish|french|german)|complete the sentence|listen and (?:respond|type|write)|select the correct (?:meaning|definition|translation|answer)|choose the correct (?:meaning|definition|translation|answer)|select the (?:right|correct) meaning|complete the sentence|fill in the blank|tap what you hear|what does this mean|which is the correct translation)[.!?]*$/i;
+
+  function realAction() {
+    var controls = document.querySelectorAll("button,[role=button]");
+    for (var i = controls.length - 1; i >= 0; i--) {
+      var button = controls[i];
+      if (button.disabled || attr(button, "aria-disabled") === "true" ||
+          !button.getClientRects().length) continue;
+      var label = (button.innerText || button.textContent || "").trim();
+      if (/^(?:check|check answer|continue|next|submit|got it|done)$/i.test(label)) {
+        return { button: button, label: label };
+      }
+    }
+    return null;
+  }
+
+  function actionLabel() {
+    var action = realAction();
+    return action ? action.label : "";
+  }
+
+  function activateAction() {
+    // Called only by a user tapping the Android Check/Continue control.
+    // The real web button remains responsible for all validation and XP.
+    var action = realAction();
+    if (!action) return false;
+    action.button.click();
+    return true;
+  }
+
+  function answerPreview() {
+    // Read-only, transient status; no answer text is stored or transmitted.
+    var inputs = document.querySelectorAll(
+      'textarea,input:not([type="hidden"]):not([type="search"]),' +
+      '[contenteditable="true"]'
+    );
+    for (var i = 0; i < inputs.length; i++) {
+      var input = inputs[i];
+      if (attr(input, "type") === "password") continue;
+      var answer = (input.value || input.innerText || "").trim();
+      if (answer) return answer.slice(0, 90);
+    }
+    var selected = document.querySelectorAll(
+      '[data-andors-ui="word"][aria-pressed="true"],' +
+      '[data-andors-ui="word"][aria-selected="true"],' +
+      '[data-andors-ui="choice"][aria-checked="true"],' +
+      '[data-andors-ui="choice"][aria-selected="true"]'
+    );
+    var pieces = [];
+    for (var j = 0; j < selected.length; j++) {
+      var text = (selected[j].innerText || selected[j].textContent || "").trim();
+      if (text) pieces.push(text);
+    }
+    return pieces.join(" ").slice(0, 90);
+  }
+
+  function questionText() { return questionValue; }
+  function audioCount() { return mirroredAudio.length; }
+
+  function playAudio(index) {
+    // This delegates one explicit user tap to the authenticated web lesson.
+    // We do not extract URLs, store audio, or reproduce Duolingo's player.
+    var original = mirroredAudio[index];
+    if (!original || !original.isConnected) return false;
+    original.click();
+    return true;
+  }
+
+  /* Read the real page's answer nodes, but render known exercise types using
+   * Android controls. Every tap/keystroke is forwarded to the original DOM;
+   * this never implements Duolingo grading or fabricates correct answers. */
+  function mainPrompt() {
+    var scope = document.querySelector('[data-test="challenge"]') || document;
+    var selectors = [
+      '[data-test="challenge-translate-prompt"],[data-test="challenge-prompt"],' +
+        '[data-test="challenge-sentence"],[data-test="challenge-phrase"],' +
+        '[data-test="challenge-text"],[data-test="challenge-word"],' +
+        '[data-test*="stimulus"],[data-test*="question"],blockquote',
+      'h1,h2,h3,p,span,[lang],[dir="auto"]'
+    ];
+    for (var pass = 0; pass < selectors.length; pass++) {
+      var candidates = scope.querySelectorAll(selectors[pass]);
+      for (var i = 0; i < candidates.length; i++) {
+        var node = candidates[i];
+        if (node.closest('button,[role=button],nav,[data-andors-ui="choice"],' +
+                         '[data-andors-ui="word"],[data-andors-ui="match"],' +
+                         '[data-andors-ui="feedback"],[data-andors-chrome="hide"],' +
+                         '[data-test="sidebar"],[data-test="topbar"]')) continue;
+        if (node.querySelector('input,textarea,button,[role=button]')) continue;
+        var value = (node.innerText || node.textContent || "")
+          .replace(/\s+/g, " ").trim();
+        if (value.length < 2 || value.length > 220 || instruction.test(value) ||
+            !/\p{L}/u.test(value) ||
+            /^(?:correct|great|nice|excellent|well done|check|continue|make harder)[.!?]*$/i.test(value)) {
+          continue;
+        }
+        return value;
+      }
+    }
+    return "";
+  }
+
