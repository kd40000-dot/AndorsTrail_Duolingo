diff --git a/AndorsTrail/app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoLessonActivity.java b/AndorsTrail/app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoLessonActivity.java
new file mode 100644
index 00000000..9b9d4641
--- /dev/null
+++ b/AndorsTrail/app/src/main/java/com/gpl/rpg/AndorsTrail/duolingo/DuolingoLessonActivity.java
@@ -0,0 +1,216 @@
+package com.gpl.rpg.AndorsTrail.duolingo;
+
+import android.annotation.SuppressLint;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.Gravity;
+import android.view.View;
+import android.webkit.CookieManager;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import org.json.JSONArray;
+import org.json.JSONException;
+
+import com.gpl.rpg.AndorsTrail.activity.AndorsTrailBaseActivity;
+
+/**
+ * First embedded Duolingo lesson prototype. All exercises remain hosted and
+ * scored by Duolingo; the app does not forge XP or mark lessons complete.
+ *
+ * The answer counter is diagnostic only, pending real-device validation.
+ * JavaScript results are read by the host using evaluateJavascript rather
+ * than exposing an Android JavaScript interface to untrusted web content.
+ */
+public final class DuolingoLessonActivity extends AndorsTrailBaseActivity {
+    private static final String START_URL = "https://www.duolingo.com/learn";
+    private WebView lesson;
+    private TextView status;
+    private TextView diagnostics;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private boolean observing;
+    private long detectedCorrect;
+    private long lastPageCount;
+    private int pageGeneration;
+    private final Runnable readAnswerCounter = new Runnable() {
+        @Override public void run() {
+            if (!observing || lesson == null) return;
+            String url = lesson.getUrl();
+            if (url != null && isDuolingoUrl(url)) {
+                final int generation = pageGeneration;
+                lesson.evaluateJavascript("[window.__andorsDuoCorrectCount||0," +
+                        "!!window.__andorsDuoMonitor,!!window.__andorsDuoFeedbackVisible," +
+                        "window.__andorsDuoScans||0]", value -> {
+                    if (generation != pageGeneration || !observing) return;
+                    try {
+                        JSONArray snapshot = new JSONArray(value);
+                        long pageCount = snapshot.getLong(0);
+                        boolean active = snapshot.getBoolean(1);
+                        boolean feedbackVisible = snapshot.getBoolean(2);
+                        long scans = snapshot.getLong(3);
+                        if (pageCount < lastPageCount) lastPageCount = pageCount;
+                        if (pageCount > lastPageCount) {
+                            // Count transitions, never duplicate a persistent feedback panel.
+                            detectedCorrect += pageCount - lastPageCount;
+                            lastPageCount = pageCount;
+                        }
+                        showCounter();
+                        diagnostics.setText((active ? "Observer active" : "Observer inactive")
+                                + " · " + (feedbackVisible ? "Feedback FOUND" : "No feedback")
+                                + " · Checks " + scans);
+                    } catch (JSONException ignored) {
+                        // Page navigation can briefly interrupt evaluation.
+                    }
+                });
+            }
+            handler.postDelayed(this, 200);
+        }
+    };
+
+    @SuppressLint("SetJavaScriptEnabled")
+    @Override public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        LinearLayout frame = new LinearLayout(this);
+        frame.setOrientation(LinearLayout.VERTICAL);
+        frame.setBackgroundColor(Color.rgb(16, 23, 28));
+
+        LinearLayout toolbar = new LinearLayout(this);
+        toolbar.setPadding(dp(12), dp(6), dp(12), dp(6));
+        toolbar.setGravity(Gravity.CENTER_VERTICAL);
+        toolbar.setBackgroundColor(Color.rgb(35, 44, 48));
+
+        status = new TextView(this);
+        status.setText("Duolingo · Vietnamese");
+        status.setTextColor(Color.WHITE);
+        status.setTextSize(16);
+        toolbar.addView(status, new LinearLayout.LayoutParams(0, dp(45), 1));
+        status.setGravity(Gravity.CENTER_VERTICAL);
+
+        Button close = new Button(this);
+        close.setText("Return to battle");
+        close.setOnClickListener(v -> finish());
+        toolbar.addView(close);
+        frame.addView(toolbar);
+
+        diagnostics = new TextView(this);
+        diagnostics.setText("Detector starting…");
+        diagnostics.setTextSize(12);
+        diagnostics.setTextColor(Color.rgb(181, 223, 175));
+        diagnostics.setPadding(dp(12), dp(2), dp(12), dp(4));
+        diagnostics.setBackgroundColor(Color.rgb(35, 44, 48));
+        frame.addView(diagnostics);
+
+        lesson = new WebView(this);
+        lesson.setBackgroundColor(Color.rgb(16, 23, 28));
+        lesson.getSettings().setJavaScriptEnabled(true);
+        lesson.getSettings().setDomStorageEnabled(true);
+        lesson.getSettings().setMediaPlaybackRequiresUserGesture(false);
+        CookieManager.getInstance().setAcceptCookie(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(lesson, true);
+        lesson.setWebChromeClient(new WebChromeClient());
+        lesson.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                // Keep authentication and exercises inside Duolingo's own site.
+                String host = request.getUrl().getHost();
+                return host == null || !(host.equals("duolingo.com") || host.endsWith(".duolingo.com"));
+            }
+
+            @Override public void onPageFinished(WebView view, String url) {
+                if (isDuolingoUrl(url)) {
+                    pageGeneration++;
+                    lastPageCount = 0;
+                    view.evaluateJavascript(STYLES, null);
+                    view.evaluateJavascript(CORRECT_FEEDBACK_MONITOR, null);
+                    showCounter();
+                }
+            }
+        });
+        frame.addView(lesson, new LinearLayout.LayoutParams(-1, 0, 1));
+        setContentView(frame);
+        lesson.loadUrl(START_URL);
+    }
+
+    // Conservative first styling pass: frame the live site with the game's
+    // dark palette without suppressing sign-in, answer or Continue controls.
+    private static final String STYLES = "(function(){" +
+            "if(document.getElementById('andors-duo-theme'))return;" +
+            "var s=document.createElement('style');s.id='andors-duo-theme';" +
+            "s.textContent='html,body{margin:0!important;}" +
+            "button{border-radius:8px!important;}';" +
+            "document.head.appendChild(s);" +
+            "})();";
+
+    // Diagnostic-only detection. Duolingo can split its green feedback label
+    // across nested nodes, which the initial leaf-selector missed. innerText
+    // provides the rendered text with line boundaries. We match complete lines
+    // and expose just booleans/counters, never lesson or answer text.
+    private static final String CORRECT_FEEDBACK_MONITOR = "(function(){" +
+            "if(window.__andorsDuoMonitor)return;" +
+            "window.__andorsDuoMonitor=true;window.__andorsDuoCorrectCount=0;" +
+            "window.__andorsDuoFeedbackVisible=false;window.__andorsDuoScans=0;" +
+            "var armed=false,visible=false,scheduled=false;" +
+            "function hasFeedback(){" +
+            "var text=(document.body&&document.body.innerText)||'';" +
+            "var lines=text.split(String.fromCharCode(10));" +
+            "for(var i=0;i<lines.length;i++){var line=lines[i].trim().toLowerCase();" +
+            "if(line==='correct!'||line==='great job!'||line==='excellent!'||" +
+            "line==='nicely done!'||line==='¡correcto!'||line==='chính xác!')return true;}" +
+            "return false;}" +
+            "function scan(){scheduled=false;var found=hasFeedback();" +
+            "window.__andorsDuoScans++;window.__andorsDuoFeedbackVisible=found;" +
+            "if(!found){armed=true;visible=false;}" +
+            "else if(armed&&!visible){visible=true;window.__andorsDuoCorrectCount++;}}" +
+            "new MutationObserver(function(){if(!scheduled){scheduled=true;requestAnimationFrame(scan);}})" +
+            ".observe(document.documentElement,{subtree:true,childList:true,characterData:true,attributes:true});" +
+            "setInterval(scan,250);" +
+            "scan();" +
+            "})();";
+
+    private static boolean isDuolingoUrl(String url) {
+        return url != null && (url.startsWith("https://www.duolingo.com/")
+                || url.startsWith("https://duolingo.com/"));
+    }
+
+    private void showCounter() {
+        status.setText("Duolingo · Correct detected: " + detectedCorrect);
+    }
+
+    private int dp(int value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    @Override protected void onResume() {
+        super.onResume();
+        if (!observing) {
+            observing = true;
+            handler.post(readAnswerCounter);
+        }
+    }
+
+    @Override protected void onPause() {
+        observing = false;
+        handler.removeCallbacks(readAnswerCounter);
+        super.onPause();
+    }
+
+    @Override public void onBackPressed() {
+        if (lesson != null && lesson.canGoBack()) lesson.goBack();
+        else super.onBackPressed();
+    }
+
+    @Override protected void onDestroy() {
+        observing = false;
+        handler.removeCallbacks(readAnswerCounter);
+        if (lesson != null) {
+            lesson.stopLoading();
+            lesson.destroy();
+            lesson = null;
+        }
+        super.onDestroy();
+    }
+}
